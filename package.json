{
  "name": "transaction-ledger-api",
  "private": true,
  "version": "1.0.0",
  "description": "Transaction Ledger API: accounts, credit/debit transactions, balances and history",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "db:local": "tsx scripts/localDb.ts",
    "db:migrate": "prisma migrate deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "dotenv": "16.4.7",
    "express": "5.1.0",
    "helmet": "8.0.0",
    "prisma": "6.19.3",
    "swagger-ui-express": "5.0.1",
    "tsx": "4.23.15",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "20.17.10",
    "@types/supertest": "6.0.2",
    "@types/swagger-ui-express": "4.1.7",
    "embedded-postgres": "17.9.0-beta.17",
    "supertest": "7.1.4",
    "typescript": "5.7.2",
    "vitest": "3.2.7"
  }
}
